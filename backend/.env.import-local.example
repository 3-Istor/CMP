APP_NAME=CMP API local
DEBUG=false
BACKGROUND_COLLECTORS_ENABLED=false
DATABASE_URL=sqlite:///./data/import-local.db
TF_BACKEND_S3_ENABLED=false
IMPORT_ENABLED=false
IMPORT_USER_AUDIENCE=account
KEYCLOAK_URL=https://auth.3istor.com
KEYCLOAK_REALM=3istor
KEYCLOAK_CLIENT_ID=3-istor-openid
KEYCLOAK_CLIENT_SECRET=
# The local launcher selects the sibling app-templates branch without cloning.
TEMPLATE_REPOSITORY_PATH=

# GitHub App OAuth is handled by CMP; CNP SSO needs no GitHub provider.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/github/callback
# Stable Fernet key generated once for a new local setup; keep it outside Git.
GITHUB_OAUTH_TOKEN_KEY=
